# Restricted Firebase *web/app* config only — not a secret by itself.
# Protect the project with Firestore rules, Auth settings, App Check, and API key restrictions.
# Copy to `.env` for local dev (`.env` is gitignored via `.env*.local` and root guidance).

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=dont-text-your-ex.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=dont-text-your-ex
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=dont-text-your-ex.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
